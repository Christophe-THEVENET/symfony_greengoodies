# Référence design (handoff, hors dépôt)
/refonte_design/

# Orchestration :
#  - prod  : compose.prod.yaml VERSIONNÉ (aucun secret, tout vient de .env.local),
#            utilisé par deploy.sh -> plus de config éditée à la main sur le serveur
#  - local : compose.yaml + compose.override.yaml, hors dépôt (chargés auto par
#            Docker Compose ; absents du serveur, donc jamais lus en prod par erreur)
#  - docker-compose.yml : ancien fichier prod, remplacé par compose.prod.yaml
/compose.yaml
/compose.override.yaml
/docker-compose.yml
/docker/nginx/default.local.conf

# Claude Code : settings locaux (non partagés)
.claude/settings.local.json
