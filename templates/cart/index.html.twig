{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} — Panier{% endblock %}

{% block body %}

{# Barre progression livraison offerte #}
{% set subtotal = cart.totalAmount %}
{% set shippingThreshold = 49 %}
{% set remaining = shippingThreshold - subtotal %}
{% if cart.items|length > 0 and remaining > 0 %}
    <div class="ship-progress">
        <p class="ship-progress__text">
            Plus que <strong>{{ remaining|number_format(2, ',', ' ') }}€</strong> pour la livraison offerte
        </p>
    </div>
{% endif %}
{% if cart.items|length > 0 and remaining <= 0 %}
    <div class="ship-progress">
        <p class="ship-progress__text">🎉 Livraison offerte !</p>
    </div>
{% endif %}

<section class="cart-page">
    {# ========== LISTE ARTICLES ========== #}
    <div class="bag">
        {% if cart.items|length > 0 %}
            {% for item in cart.items %}
                <div class="bag-item"
                     data-product-id="{{ item.product.id }}"
                     {{ stimulus_controller('cart', {
                         url: path('api_cart_update', {productId: item.product.id}),
                         removeUrl: path('api_cart_remove', {productId: item.product.id}),
                         productId: item.product.id
                     }) }}>
                    <div class="bag-item__image">
                        <img src="{{ asset('img/products/' ~ item.product.imageFilename) }}" alt="{{ item.product.name }}" />
                    </div>
                    <div class="bag-item__meta">
                        <div class="bag-item__name">{{ item.product.name }}</div>
                        <div class="bag-item__variant">{{ item.product.shortDescription|slice(0, 60) }}…</div>
                        <div class="bag-item__actions">
                            <div class="bag-item__qty">
                                <button type="button" class="qty-btn" data-action="click->cart#decrement" aria-label="Moins">−</button>
                                <input type="number"
                                       value="{{ item.quantity }}"
                                       min="1"
                                       {{ stimulus_target('cart', 'quantity') }}
                                       {{ stimulus_action('cart', 'updateQuantity', 'change') }} />
                                <button type="button" class="qty-btn" data-action="click->cart#increment" aria-label="Plus">+</button>
                            </div>
                            <button type="button" class="bag-item__remove"
                                    {{ stimulus_action('cart', 'removeItem', 'click') }}
                                    aria-label="Retirer du panier">
                                ×
                            </button>
                        </div>
                    </div>
                    <div class="bag-item__price"
                         {{ stimulus_target('cart', 'total') }}>
                        {{ item.total_price|number_format(2, ',', ' ') }}€
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="bag__empty">
                <p>Votre panier est vide.</p>
                <p><a href="{{ path('app_home') }}">Découvrir nos produits →</a></p>
            </div>
        {% endif %}
    </div>

    {# ========== RÉCAPITULATIF ========== #}
    <div class="cart-summary">
        <h3 class="cart-summary__title">Récapitulatif</h3>

        {% if cart.items|length > 0 %}
            {% set shipping = remaining > 0 ? 4.90 : 0 %}
            {% set ecoDiscount = subtotal * 0.10 %}
            {% set total = subtotal + shipping - ecoDiscount %}

            <div class="cart-summary__row">
                <span>Sous-total</span>
                <span>{{ subtotal|number_format(2, ',', ' ') }}€</span>
            </div>
            <div class="cart-summary__row">
                <span>Livraison</span>
                <span>{{ shipping > 0 ? shipping|number_format(2, ',', ' ') ~ '€' : 'Offerte' }}</span>
            </div>
            <div class="cart-summary__row cart-summary__row--discount">
                <span>Réduction éco (-10%)</span>
                <span>−{{ ecoDiscount|number_format(2, ',', ' ') }}€</span>
            </div>

            <div class="cart-summary__promo">
                <input type="text" placeholder="Code promo" />
                <button type="button" class="btn btn--ghost btn--sm">Appliquer</button>
            </div>

            <div class="cart-summary__row cart-summary__row--total">
                <span>Total</span>
                <span data-cart-total>{{ total|number_format(2, ',', ' ') }}€</span>
            </div>

            <form {{ stimulus_controller('cart', {
                    url: path('api_cart_validate')
                }) }}
                {{ stimulus_action('cart', 'validateCart', 'submit') }}>
                <input type="hidden" name="_token" value="{{ csrf_token('app_order_validate') }}" />
                <button type="submit" class="cart-summary__cta">Passer la commande</button>
            </form>

            <p class="cart-summary__reassurance">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                Paiement 100% sécurisé · Retour gratuit 30 jours
            </p>

            {# Vider le panier #}
            <div style="text-align:center;margin-top:1rem;">
                <button type="button" class="btn btn--ghost btn--sm"
                    {{ stimulus_controller('cart', { url: path('api_cart_clear') }) }}
                    {{ stimulus_action('cart', 'clearCart', 'click') }}>
                    Vider le panier
                </button>
            </div>
        {% else %}
            <div class="cart-summary__empty">Ajoutez des produits pour voir le récapitulatif.</div>
        {% endif %}
    </div>
</section>

{% endblock %}
