<header class="header" data-controller="header" data-header-active-class="is-open">
    <div class="wrap header__bar">
        <a href="{{ path('app_home') }}" class="logo">
            <span class="logo__mark">G</span>GreenGoodies
        </a>

        <nav class="nav" data-nav>
            <a href="{{ path('app_home') }}#products">Produits</a>
            <a href="{{ path('app_home') }}#story">Notre histoire</a>
            <a href="{{ path('app_home') }}#values">Valeurs</a>
            <a href="{{ path('app_home') }}#news">Journal</a>
        </nav>

        <div class="header__right">
            <div class="lang">
                <button class="is-active" data-lang-btn="fr">FR</button>
                <span>/</span>
                <button data-lang-btn="en">EN</button>
            </div>

            {% if app.user %}
                <a href="{{ path('app_account') }}" class="icon-btn" aria-label="Compte">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="icon-btn" aria-label="Se connecter">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
                </a>
            {% endif %}

            <a href="{{ path('app_cart') }}" class="cart-btn">
                <span>Panier</span>
                {% if cart_count() > 0 %}
                    <span class="badge" data-cart-badge>{{ cart_count() }}</span>
                {% else %}
                    <span class="badge" data-cart-badge style="display:none;"></span>
                {% endif %}
            </a>

            <button class="burger" data-header-target="burger" data-action="click->header#toggle" aria-label="Menu" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>

    {# Menu mobile #}
    <nav class="nav" data-header-target="mobileMenu" data-nav style="display:none">
        <a href="{{ path('app_home') }}" data-action="click->header#closeOnLink">Produits</a>
        <a href="{{ path('app_home') }}#story" data-action="click->header#closeOnLink">Notre histoire</a>
        <a href="{{ path('app_cart') }}" data-action="click->header#closeOnLink">Panier</a>
        {% if app.user %}
            <a href="{{ path('app_account') }}" data-action="click->header#closeOnLink">Mon compte</a>
            <a href="{{ path('app_logout') }}">Se déconnecter</a>
        {% else %}
            <a href="{{ path('app_login') }}" data-action="click->header#closeOnLink">Se connecter</a>
        {% endif %}
    </nav>

    <div class="header__overlay" data-header-target="overlay" data-action="click->header#closeOnOverlay"></div>
</header>
