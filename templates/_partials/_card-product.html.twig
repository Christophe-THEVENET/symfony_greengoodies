<article class="card" data-reveal>
    <a class="card__media" href="{{ path('app_product_show', { slug: product.slug }) }}" aria-label="{{ product.name }}">
        <img src="{{ asset('img/products/' ~ product.imageFilename) }}" alt="{{ product.name }}" loading="lazy" />
    </a>
    <div class="card__body">
        <h3 class="card__name"><a href="{{ path('app_product_show', { slug: product.slug }) }}">{{ product.name|trans }}</a></h3>
        <p class="card__desc">{{ product.shortDescription|trans }}</p>
        <div class="card__foot">
            <span class="card__price">{{ product.price|number_format(2, ',', ' ') }}€</span>
            <a class="card__add" href="{{ path('app_product_show', { slug: product.slug }) }}" aria-label="{{ product.name }}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
        </div>
    </div>
</article>
