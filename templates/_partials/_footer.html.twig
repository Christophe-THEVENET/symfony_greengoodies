<footer class="footer">
    <div class="wrap">
        <div class="footer__top">
            <div class="footer__brand">
                <a href="{{ path('app_home') }}" class="logo"><span class="logo__mark">G</span>GreenGoodies</a>
                <p>{{ 'footer.tagline'|trans }}</p>
            </div>
            <div class="footer__col"><h5>{{ 'footer.shop'|trans }}</h5><span class="footer__link">{{ 'footer.shop_hygiene'|trans }}</span><span class="footer__link">{{ 'footer.shop_accessories'|trans }}</span><span class="footer__link">{{ 'footer.shop_drinks'|trans }}</span><span class="footer__link">{{ 'footer.shop_giftcards'|trans }}</span></div>
            <div class="footer__col"><h5>{{ 'footer.house'|trans }}</h5><a href="{{ path('app_home') }}#histoire" class="footer__link">{{ 'footer.our_story'|trans }}</a><a href="{{ path('app_home') }}#valeurs" class="footer__link">{{ 'footer.our_values'|trans }}</a><a href="{{ path('app_home') }}#newsletter" class="footer__link">{{ 'nav.newsletter'|trans }}</a><a href="#" class="footer__link">{{ 'footer.contact'|trans }}</a></div>
            <div class="footer__col"><h5>{{ 'footer.help'|trans }}</h5><span class="footer__link">{{ 'footer.shipping_returns'|trans }}</span><a href="{{ path('app_account') }}" class="footer__link">{{ 'nav.account'|trans }}</a><span class="footer__link">{{ 'footer.cgv'|trans }}</span><span class="footer__link">{{ 'footer.privacy'|trans }}</span></div>
        </div>
        <div class="footer__bottom"><span>&copy; {{ 'footer.copyright'|trans({'%year%': 'now'|date('Y')}) }}</span><span>{{ 'footer.developed_by'|trans }} <a href="https://christophethevenet.fr" target="_blank" rel="noopener">Digitob</a></span><span>{{ 'footer.crafted'|trans }}</span></div>
    </div>
</footer>
