{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} — {{ 'nav.account'|trans }}{% endblock %}

{% block body %}

{% import _self as m %}

<section class="account-page" data-controller="account-tabs" data-account-tabs-active-value="{{ activeTab }}">

    {# ========== SIDEBAR ========== #}
    <aside class="account-sidebar">
        <button type="button" class="account-sidebar__link" data-account-tabs-target="tab" data-tab="overview" data-action="account-tabs#select">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {{ 'account.nav_overview'|trans }}
        </button>
        <button type="button" class="account-sidebar__link" data-account-tabs-target="tab" data-tab="commandes" data-action="account-tabs#select">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="23 7 16 12 23 17 23 7"/><circle cx="8" cy="19" r="2"/><circle cx="16" cy="19" r="2"/></svg>
            {{ 'account.nav_orders'|trans }}
        </button>
        <button type="button" class="account-sidebar__link" data-account-tabs-target="tab" data-tab="adresses" data-action="account-tabs#select">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {{ 'account.nav_addresses'|trans }}
        </button>
        <button type="button" class="account-sidebar__link" data-account-tabs-target="tab" data-tab="profil" data-action="account-tabs#select">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            {{ 'account.nav_profile'|trans }}
        </button>
        <div class="account-sidebar__logout">
            <a href="{{ path('app_logout') }}" class="account-sidebar__link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                {{ 'account.nav_logout'|trans }}
            </a>
        </div>
    </aside>

    {# ========== CONTENU ========== #}
    <div class="account-content">
        <div class="account-header">
            <div class="account-header__avatar">{{ app.user.firstname[:1]|upper }}{{ app.user.lastname[:1]|upper }}</div>
            <div>
                <div class="account-header__greeting">{{ 'account.greeting'|trans }}, {{ app.user.firstname }}</div>
                <div class="account-header__since">{{ 'account.member_since'|trans }} {{ app.user.createdAt ? app.user.createdAt|date('m/Y') : '—' }}</div>
            </div>
        </div>

        {# ===== PANEL : VUE D'ENSEMBLE ===== #}
        <div class="account-panel" data-account-tabs-target="panel" data-tab="overview">
            <div class="account-stats">
                <div class="stat-card">
                    <div class="stat-card__icon stat-card__icon--terra">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="23 7 16 12 23 17 23 7"/><circle cx="8" cy="19" r="2"/><circle cx="16" cy="19" r="2"/></svg>
                    </div>
                    <div class="stat-card__value">{{ orders|length }}</div>
                    <div class="stat-card__label">{{ 'account.stat_orders'|trans }}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card__icon stat-card__icon--olive">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    </div>
                    <div class="stat-card__value">{{ app.user.addresses|length }}</div>
                    <div class="stat-card__label">{{ 'account.stat_addresses'|trans }}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card__icon stat-card__icon--clay">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </div>
                    <div class="stat-card__value">{{ app.user.createdAt ? app.user.createdAt|date('Y') : '—' }}</div>
                    <div class="stat-card__label">{{ 'account.stat_member_year'|trans }}</div>
                </div>
            </div>

            <div class="orders-section">
                <h3 class="orders-section__title">{{ 'account.orders_title'|trans }}</h3>
                {% for order in orders|slice(0, 3) %}
                    {{ m.orderRow(order) }}
                {% else %}
                    <p class="account-empty">{{ 'account.no_orders'|trans }}</p>
                {% endfor %}
            </div>
        </div>

        {# ===== PANEL : COMMANDES ===== #}
        <div class="account-panel" data-account-tabs-target="panel" data-tab="commandes">
            <div class="orders-section">
                <h3 class="orders-section__title">{{ 'account.nav_orders'|trans }}</h3>
                {% for order in orders %}
                    {{ m.orderRow(order) }}
                {% else %}
                    <p class="account-empty">{{ 'account.no_orders'|trans }}</p>
                {% endfor %}
            </div>
        </div>

        {# ===== PANEL : ADRESSES ===== #}
        <div class="account-panel" data-account-tabs-target="panel" data-tab="adresses">
            <h3 class="orders-section__title">{{ 'account.nav_addresses'|trans }}</h3>

            {% if app.user.addresses|length > 0 %}
                <div class="address-grid">
                    {% for address in app.user.addresses %}
                        <div class="address-card {{ address.isDefault ? 'address-card--default' }}">
                            {% if address.isDefault %}<span class="address-card__badge">{{ 'address.default_badge'|trans }}</span>{% endif %}
                            <div class="address-card__label">{{ address.label }}</div>
                            <p class="address-card__body">
                                {{ app.user.firstname }} {{ app.user.lastname }}<br>
                                {{ address.line1 }}{% if address.line2 %}<br>{{ address.line2 }}{% endif %}<br>
                                {{ address.postalCode }} {{ address.city }}<br>
                                {{ address.country }}
                            </p>
                            <div class="address-card__actions">
                                {% if not address.isDefault %}
                                    <form method="post" action="{{ path('app_address_default', {id: address.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('default_address_' ~ address.id) }}">
                                        <button type="submit" class="link-btn">{{ 'address.set_default'|trans }}</button>
                                    </form>
                                {% endif %}
                                <a href="{{ path('app_address_edit', {id: address.id}) }}" class="link-btn">{{ 'address.edit'|trans }}</a>
                                <form method="post" action="{{ path('app_address_delete', {id: address.id}) }}" onsubmit="return confirm('{{ 'address.delete_confirm'|trans|e('js') }}');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_address_' ~ address.id) }}">
                                    <button type="submit" class="link-btn link-btn--danger">{{ 'address.delete'|trans }}</button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="account-empty">{{ 'address.empty'|trans }}</p>
            {% endif %}

            <div class="account-section">
                <h4 class="account-section__title">{{ editingAddress ? 'address.edit_title'|trans : 'address.add_title'|trans }}</h4>
                {{ form_start(addressForm, { attr: { class: 'address-form', novalidate: 'novalidate' }, action: editingAddress ? path('app_address_edit', {id: editingAddress.id}) : path('app_account') }) }}
                    <div class="address-form__row">
                        <div class="field">{{ form_label(addressForm.label) }}{{ form_widget(addressForm.label) }}{{ form_errors(addressForm.label) }}</div>
                    </div>
                    <div class="field">{{ form_label(addressForm.line1) }}{{ form_widget(addressForm.line1) }}{{ form_errors(addressForm.line1) }}</div>
                    <div class="field">{{ form_label(addressForm.line2) }}{{ form_widget(addressForm.line2) }}{{ form_errors(addressForm.line2) }}</div>
                    <div class="address-form__row">
                        <div class="field">{{ form_label(addressForm.postalCode) }}{{ form_widget(addressForm.postalCode) }}{{ form_errors(addressForm.postalCode) }}</div>
                        <div class="field">{{ form_label(addressForm.city) }}{{ form_widget(addressForm.city) }}{{ form_errors(addressForm.city) }}</div>
                    </div>
                    <div class="field">{{ form_label(addressForm.country) }}{{ form_widget(addressForm.country) }}{{ form_errors(addressForm.country) }}</div>
                    <div class="field field--check">{{ form_widget(addressForm.isDefault) }}{{ form_label(addressForm.isDefault) }}</div>
                    <div class="address-form__actions">
                        <button type="submit" class="btn btn--solid">{{ editingAddress ? 'address.save'|trans : 'address.add'|trans }}</button>
                        {% if editingAddress %}<a href="{{ path('app_account', {tab: 'adresses'}) }}" class="link-btn">{{ 'address.cancel'|trans }}</a>{% endif %}
                    </div>
                {{ form_end(addressForm) }}
            </div>
        </div>

        {# ===== PANEL : PROFIL & SÉCURITÉ ===== #}
        <div class="account-panel" data-account-tabs-target="panel" data-tab="profil">
            <div class="account-section">
                <h3 class="account-section__title">{{ 'account.profile_title'|trans }}</h3>
                {{ form_start(profileForm, { attr: { novalidate: 'novalidate' } }) }}
                    <div class="address-form__row">
                        <div class="field">{{ form_label(profileForm.firstname) }}{{ form_widget(profileForm.firstname) }}{{ form_errors(profileForm.firstname) }}</div>
                        <div class="field">{{ form_label(profileForm.lastname) }}{{ form_widget(profileForm.lastname) }}{{ form_errors(profileForm.lastname) }}</div>
                    </div>
                    <div class="field">
                        <label>{{ 'form.email'|trans }}</label>
                        <input type="email" value="{{ app.user.email }}" disabled>
                        <small class="field__hint">{{ 'account.email_locked'|trans }}</small>
                    </div>
                    <button type="submit" class="btn btn--solid">{{ 'account.save_profile'|trans }}</button>
                {{ form_end(profileForm) }}
            </div>

            <div class="account-section">
                <h3 class="account-section__title">{{ 'account.password_title'|trans }}</h3>
                {{ form_start(passwordForm, { attr: { novalidate: 'novalidate' } }) }}
                    <div class="field">{{ form_label(passwordForm.currentPassword) }}{{ form_widget(passwordForm.currentPassword) }}{{ form_errors(passwordForm.currentPassword) }}</div>
                    <div class="address-form__row">
                        <div class="field">{{ form_label(passwordForm.plainPassword.first) }}{{ form_widget(passwordForm.plainPassword.first) }}</div>
                        <div class="field">{{ form_label(passwordForm.plainPassword.second) }}{{ form_widget(passwordForm.plainPassword.second) }}</div>
                    </div>
                    {{ form_errors(passwordForm.plainPassword) }}
                    <button type="submit" class="btn btn--solid">{{ 'account.save_password'|trans }}</button>
                {{ form_end(passwordForm) }}
            </div>

            <div class="account-section">
                <h3 class="account-section__title">{{ 'account.api_title'|trans }}</h3>
                <form method="post" action="{{ path('api_account_toggle_api') }}" data-controller="account" data-action="submit->account#toggleApiAccess">
                    <input type="hidden" name="_token" value="{{ csrf_token('access_api') }}" />
                    <button type="submit" class="btn btn--ghost" data-account-target="button">
                        {{ app.user.apiAccessEnabled ? 'account.api_disable'|trans : 'account.api_enable'|trans }}
                    </button>
                </form>
            </div>

            <div class="account-section account-section--danger">
                <h3 class="account-section__title">{{ 'account.danger_title'|trans }}</h3>
                <form method="post" action="{{ path('app_account_delete') }}" onsubmit="return confirm('{{ 'account.delete_confirm'|trans|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}" />
                    <button type="submit" class="btn--danger">{{ 'account.delete_account'|trans }}</button>
                </form>
            </div>
        </div>
    </div>
</section>

{# Ligne de commande réutilisable #}
{% macro orderRow(order) %}
    {% set delivered = order.createdAt < date('-5 days') %}
    <div class="order-row">
        <div class="order-row__images">
            {% for item in order.orderItems %}
                <img src="{{ asset('img/products/' ~ item.product.imageFilename) }}" alt="{{ item.product.name }}" />
            {% endfor %}
        </div>
        <div class="order-row__id">#{{ order.orderNumber }}</div>
        <span class="order-row__status {{ delivered ? 'order-row__status--done' : 'order-row__status--transit' }}">
            {{ (delivered ? 'account.status_delivered' : 'account.status_transit')|trans }}
        </span>
        <div class="order-row__total">{{ order.totalAmount|number_format(2, ',', ' ') }}€</div>
        <div class="order-row__date">{{ order.createdAt|date('d/m/Y') }}</div>
    </div>
{% endmacro %}

{% endblock %}
